<Window x:Class="RasTweaksCS.UpdateCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RasTweaks"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Window.Resources>
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4CAF50" Offset="0"/>
            <GradientStop Color="#00D9C2" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border Background="#0A0A0A" CornerRadius="14" BorderBrush="#1E1E1E" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#4CAF50" BlurRadius="28" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <StackPanel Margin="30">
            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentGradientBrush}" HorizontalAlignment="Center" Margin="0,0,0,18">
                <TextBlock Text="RX" FontSize="17" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Ellipse x:Name="Spinner"
                         Width="48" Height="48"
                         Stroke="#4CAF50"
                         StrokeThickness="4"
                         StrokeDashArray="9,6"
                         StrokeStartLineCap="Round"
                         StrokeEndLineCap="Round"
                         Fill="Transparent"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <TextBlock x:Name="StatusText"
                       Text="Checking for updates..."
                       FontSize="13"
                       Foreground="#A8A8A8"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,14"/>

            <Border x:Name="ProgressTrack" Height="8" CornerRadius="4" Background="#1A1A1A" Visibility="Collapsed">
                <Border x:Name="ProgressFill" Height="8" CornerRadius="4" Background="{StaticResource AccentGradientBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </StackPanel>
    </Border>
</Window>
