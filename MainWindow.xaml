<Window x:Class="RasTweaksCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RasTweaksCS"
        mc:Ignorable="d"
        Title="RasTweaks" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="White"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Window.Resources>
        <local:RiskToBrushConverter x:Key="RiskToBrushConverter"/>
        <local:CategoryToIconConverter x:Key="CategoryToIconConverter"/>
        <local:EmptyStringToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>

        <!-- Palette -->
        <SolidColorBrush x:Key="AccentGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00D9FF"/>
        <SolidColorBrush x:Key="CardBg" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="MutedText" Color="#9A9A9A"/>

        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4CAF50" Offset="0"/>
            <GradientStop Color="#00D9C2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WindowBackdropBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#000000" Offset="0"/>
            <GradientStop Color="#050505" Offset="0.55"/>
            <GradientStop Color="#000000" Offset="1"/>
        </LinearGradientBrush>

        <!-- Sidebar nav buttons: icon + label, glow when active -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,10"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.93" ScaleY="0.93"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#161616"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#141414"/>
                    <Setter Property="Foreground" Value="#4CFFA0"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#4CAF50" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary CTA button -->
        <Style x:Key="ApplyButton" TargetType="Button">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="#4CFFA0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextElement.Foreground="{TemplateBinding Foreground}"
                                               TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#4CAF50" BlurRadius="16" ShadowDepth="0" Opacity="0.65"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#1F1F1F"/>
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CRASH FIX: Moved hover animation to a proper style with triggers instead of EventTriggers -->
        <Style x:Key="TweakCardBorder" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.02" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.02" Duration="0:0:0.2"/>
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" To="#4CAF50" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" To="#1E1E1E" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatCardBorder" TargetType="Border" BasedOn="{StaticResource TweakCardBorder}"/>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#A8A8A8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#161616"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Slim accent-colored scrollbar to replace the default system chrome -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#2A2A2A" CornerRadius="4" Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentGreen}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackdropBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Custom Titlebar -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#000000" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitlebarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentGradientBrush}" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#4CAF50" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <TextBlock Text="RX" FontSize="13" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="RASX Premium Utility" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,5,0">
                        <Button Content="─" Click="OnMinimize" Style="{StaticResource WindowControlButton}" Margin="0,0,2,0"/>
                        <Button Content="□" Click="OnMaximize" Style="{StaticResource WindowControlButton}" Margin="0,0,2,0"/>
                        <Button Content="✕" Click="OnClose">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF4B4B"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sidebar -->
            <Border Grid.Row="1" Grid.Column="0" Background="#000000" BorderBrush="#1A1A1A" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20,0,0">
                    <Button x:Name="HomeNavBtn" Click="OnHomeClick" Style="{StaticResource SidebarButton}" ToolTip="Home" Tag="Active">
                        <StackPanel>
                            <TextBlock Text="🏠" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Home" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AllTweaksNavBtn" Click="OnAllTweaksClick" Style="{StaticResource SidebarButton}" ToolTip="All Tweaks">
                        <StackPanel>
                            <TextBlock Text="📋" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="All" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Border Height="1" Background="#1A1A1A" Margin="16,10"/>
                    <Button x:Name="NetworkNavBtn" Click="OnNetworkClick" Style="{StaticResource SidebarButton}" ToolTip="Network">
                        <StackPanel>
                            <TextBlock Text="🌐" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Network" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PowerNavBtn" Click="OnPowerClick" Style="{StaticResource SidebarButton}" ToolTip="Power">
                        <StackPanel>
                            <TextBlock Text="⚡" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Power" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BootNavBtn" Click="OnBootClick" Style="{StaticResource SidebarButton}" ToolTip="Boot">
                        <StackPanel>
                            <TextBlock Text="🖥️" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Boot" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SystemNavBtn" Click="OnSystemClick" Style="{StaticResource SidebarButton}" ToolTip="System">
                        <StackPanel>
                            <TextBlock Text="🔧" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="System" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="KernelNavBtn" Click="OnKernelClick" Style="{StaticResource SidebarButton}" ToolTip="Kernel">
                        <StackPanel>
                            <TextBlock Text="💻" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Kernel" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="GpuNavBtn" Click="OnGpuClick" Style="{StaticResource SidebarButton}" ToolTip="GPU">
                        <StackPanel>
                            <TextBlock Text="🎮" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="GPU" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AimNavBtn" Click="OnAimClick" Style="{StaticResource SidebarButton}" ToolTip="Aim">
                        <StackPanel>
                            <TextBlock Text="🎯" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Aim" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Border Height="1" Background="#24293A" Margin="16,10"/>
                    <Button x:Name="CreditsNavBtn" Click="OnCreditsClick" Style="{StaticResource SidebarButton}" ToolTip="Credits">
                        <StackPanel>
                            <TextBlock Text="✨" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Credits" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="HeaderIcon" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock FontSize="34" FontWeight="Bold" x:Name="CategoryTitle" Foreground="{StaticResource AccentGradientBrush}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#4CAF50" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock FontSize="14" x:Name="CategoryDescription" TextWrapping="Wrap" Foreground="#A8A8A8" Margin="0,4,0,0">All available system optimizations</TextBlock>
                    </StackPanel>

                    <Button x:Name="RefreshInfoButton" Grid.Column="1" Click="OnRefreshSystemInfo" VerticalAlignment="Center" Cursor="Hand" ToolTip="Refresh system info">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0A0A0A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#B8B8B8"/>
                                <Setter Property="Padding" Value="14,9"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#161616"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RefreshIcon" Text="🔄" FontSize="13" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="RefreshIconRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="Refresh" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Home View -->
                <ScrollViewer Grid.Row="1" x:Name="HomeView" VerticalScrollBarVisibility="Auto">
                    <WrapPanel>
                        <!-- CPU Info -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="#1E1E1E" BorderThickness="1" Padding="24" Margin="0,0,16,16" CornerRadius="14" Width="380" Style="{StaticResource StatCardBorder}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.35"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="#141414">
                                        <TextBlock Text="💻" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0">CPU</TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="CpuInfo" FontSize="14" Foreground="#B8B8B8" TextWrapping="Wrap" LineHeight="20">Loading CPU info...</TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- RAM Info -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="#1E1E1E" BorderThickness="1" Padding="24" Margin="0,0,16,16" CornerRadius="14" Width="380" Style="{StaticResource StatCardBorder}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.35"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="#141414">
                                        <TextBlock Text="🧠" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0">RAM</TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="RamInfo" FontSize="14" Foreground="#B8B8B8" TextWrapping="Wrap" LineHeight="20">Loading RAM info...</TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- GPU Info -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="#1E1E1E" BorderThickness="1" Padding="24" Margin="0,0,16,16" CornerRadius="14" Width="380" Style="{StaticResource StatCardBorder}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.35"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="#141414">
                                        <TextBlock Text="🎮" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0">GPU</TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="GpuInfo" FontSize="14" Foreground="#B8B8B8" TextWrapping="Wrap" LineHeight="20">Loading GPU info...</TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- System Info -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="#1E1E1E" BorderThickness="1" Padding="24" Margin="0,0,16,16" CornerRadius="14" Width="380" Style="{StaticResource StatCardBorder}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.35"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="#141414">
                                        <TextBlock Text="🖥️" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0">System</TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="SystemInfo" FontSize="14" Foreground="#B8B8B8" TextWrapping="Wrap" LineHeight="20">Loading system info...</TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Storage Info -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="#1E1E1E" BorderThickness="1" Padding="24" Margin="0,0,16,16" CornerRadius="14" Width="380" Style="{StaticResource StatCardBorder}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.35"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="#141414">
                                        <TextBlock Text="💾" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0">Storage</TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="StorageInfo" FontSize="14" Foreground="#B8B8B8" TextWrapping="Wrap" LineHeight="20">Loading storage info...</TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Network Info -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="#1E1E1E" BorderThickness="1" Padding="24" Margin="0,0,16,16" CornerRadius="14" Width="380" Style="{StaticResource StatCardBorder}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.35"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="#141414">
                                        <TextBlock Text="🌐" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0">Network</TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="NetworkInfo" FontSize="14" Foreground="#B8B8B8" TextWrapping="Wrap" LineHeight="20">Loading network info...</TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Discord CTA -->
                        <Button Click="OnDiscordClick" Cursor="Hand" HorizontalContentAlignment="Stretch" Margin="0,0,16,16">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#5865F2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#4752C4" Padding="24" CornerRadius="14" Width="380"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.35"/>
                                                    </Border.Effect>
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#4752C4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bg" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="#4752C4">
                                        <TextBlock Text="💬" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0">Join the Discord</TextBlock>
                                </StackPanel>
                                <TextBlock FontSize="14" Foreground="#E4E5FF" TextWrapping="Wrap" LineHeight="20">Get support, share feedback, and hang out with other testers. Click to open the invite.</TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Credits CTA -->
                        <Button Click="OnCreditsCardClick" Cursor="Hand" HorizontalContentAlignment="Stretch" Margin="0,0,16,16">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#000000"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#1E1E1E" Padding="24" CornerRadius="14" Width="380"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.35"/>
                                                    </Border.Effect>
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="#4CAF50"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bg" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="#141414">
                                        <TextBlock Text="✨" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0">Credits</TextBlock>
                                </StackPanel>
                                <TextBlock FontSize="14" Foreground="#B8B8B8" TextWrapping="Wrap" LineHeight="20">See who made this, what it's built with, and where to find us.</TextBlock>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </ScrollViewer>

                <!-- Tweak List -->
                <ScrollViewer Grid.Row="1" x:Name="TweakListView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="TweakList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- CRASH FIX: Use Style instead of inline EventTriggers -->
                                <Border Background="#000000" BorderBrush="#1E1E1E" BorderThickness="1" Padding="0" Margin="0,0,16,16" CornerRadius="12" Width="380"
                                        Style="{StaticResource TweakCardBorder}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left edge: kept black, risk is indicated by the badge chip instead -->
                                        <Border Grid.Column="0" Background="#000000" CornerRadius="12,0,0,12"/>

                                        <Grid Grid.Column="1" Margin="18,18,20,18">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header: category icon + risk badge -->
                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="16" Text="{Binding Category, Converter={StaticResource CategoryToIconConverter}}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="{Binding Risk, Converter={StaticResource RiskToBrushConverter}}" CornerRadius="4" Padding="7,3" HorizontalAlignment="Right">
                                                    <TextBlock FontSize="10" Text="{Binding Risk}" Foreground="#000000" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <!-- Content -->
                                            <StackPanel Grid.Row="1">
                                                <TextBlock FontWeight="Bold" FontSize="16" Text="{Binding Label}" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                                <TextBlock FontSize="13" Text="{Binding Description}" TextWrapping="Wrap" Foreground="#B8B8B8" Margin="0,8,0,0" LineHeight="18"/>

                                                <!-- Warning banner: only shown when the tweak carries a Warning -->
                                                <Border Background="#1A140C" BorderBrush="{Binding Risk, Converter={StaticResource RiskToBrushConverter}}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                                                        Visibility="{Binding Warning, Converter={StaticResource EmptyToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚠" FontSize="12" Foreground="{Binding Risk, Converter={StaticResource RiskToBrushConverter}}" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                                        <TextBlock Text="{Binding Warning}" FontSize="11" Foreground="#C8C8C8" TextWrapping="Wrap" LineHeight="15"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Button -->
                                            <Button Grid.Row="2" Content="Apply" Click="OnApplyTweak" Tag="{Binding Key}" Style="{StaticResource ApplyButton}" Margin="0,14,0,0" HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Credits -->
                <ScrollViewer Grid.Row="1" x:Name="CreditsView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Left" MaxWidth="480" Margin="0,10,0,0">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentGradientBrush}" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect Color="#4CAF50" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock Text="RX" FontSize="24" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="RasTweaks" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CreditsVersionText" Text="Version 1.0.0" FontSize="13" Foreground="#8A8A8A" Margin="0,0,0,24"/>

                        <Border Background="#000000" BorderBrush="#1E1E1E" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Created by" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" Margin="0,0,0,6"/>
                                <TextBlock Text="kendalmom27-ui" FontSize="15" FontWeight="Bold" Foreground="#4CFFA0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#000000" BorderBrush="#1E1E1E" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Built with" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" Margin="0,0,0,6"/>
                                <TextBlock Text="WPF on .NET 8, with Claude Code" FontSize="14" Foreground="#B8B8B8"/>
                            </StackPanel>
                        </Border>

                        <Button Click="OnDiscordClick" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#5865F2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#4752C4" Padding="20" CornerRadius="12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="💬" FontSize="18" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Join the Discord" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#4752C4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Startup overlay: creates a safety restore point before any tweaks can be applied -->
            <Grid x:Name="StartupOverlay" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#DD000000">
                <Border Width="360" Padding="30" CornerRadius="16" Background="#0A0A0A" BorderBrush="#1E1E1E" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#4CAF50" BlurRadius="30" ShadowDepth="0" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Setting Up RasTweaks" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                            <Ellipse Width="64" Height="64"
                                     Stroke="#4CAF50"
                                     StrokeThickness="4"
                                     StrokeDashArray="10,7"
                                     StrokeStartLineCap="Round"
                                     StrokeEndLineCap="Round"
                                     Fill="Transparent"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="StartupSpinnerRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <TextBlock x:Name="StartupStatusText"
                                   Text="Loading assets..."
                                   FontSize="13"
                                   Foreground="#A8A8A8"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,22,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
