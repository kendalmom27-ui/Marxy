<Window x:Class="RasTweaksCS.TweakNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RasTweaksCS"
        mc:Ignorable="d"
        Title=""
        Width="420"
        Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border x:Name="RootBorder"
            Background="#0A0A0A"
            CornerRadius="14"
            BorderBrush="#1E1E1E"
            BorderThickness="1"
            MouseLeftButtonDown="OnDismissClick">
        <Border.Effect>
            <DropShadowEffect x:Name="GlowEffect" Color="#4CAF50" BlurRadius="28" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleText"
                       Text="Applying Tweak"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <!-- Loading Spinner / Success Checkmark -->
            <Grid Grid.Row="1"
                  Width="72"
                  Height="72"
                  HorizontalAlignment="Center">

                <!-- CRASH FIX: Removed XAML storyboard animation, using code-behind timer instead -->
                <Ellipse x:Name="LoadingSpinner"
                         Width="72"
                         Height="72"
                         Stroke="#4CAF50"
                         StrokeThickness="4"
                         StrokeDashArray="11,8"
                         StrokeStartLineCap="Round"
                         StrokeEndLineCap="Round"
                         Fill="Transparent"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Success Checkmark -->
                <Border x:Name="SuccessCheckmark"
                        Width="72" Height="72"
                        CornerRadius="36"
                        Background="#1C3A28"
                        Visibility="Collapsed">
                    <TextBlock Text="✓"
                               FontSize="40"
                               FontWeight="Bold"
                               Foreground="#4CFFA0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Error Mark -->
                <Border x:Name="ErrorMark"
                        Width="72" Height="72"
                        CornerRadius="36"
                        Background="#3A1F22"
                        Visibility="Collapsed">
                    <TextBlock Text="✕"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#FF6B6B"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Status -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Text="Loading..."
                       FontSize="15"
                       Foreground="#A8A8A8"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>

            <!-- Dismiss hint -->
            <TextBlock Grid.Row="3"
                       Text="Click anywhere to dismiss"
                       FontSize="11"
                       Foreground="#5A5A5A"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"/>
        </Grid>
    </Border>
</Window>